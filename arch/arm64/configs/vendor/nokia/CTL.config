# Nokia 7.1 (CTL), SDM636. Applied after vendor/nokia/nokia.config.
CONFIG_ARCH_NOKIA_SDM660=y
CONFIG_MACH_NOKIA_CTL=y

# Bring-up: ctl_panic_after=<s> cmdline timer, inert without it
CONFIG_CTL_PANIC_AFTER=y

# Camera off during bring-up: camera_v2's subdevice drivers keep hitting
# probe-order bugs on 4.19, and the stock mm-camera blobs need the FIH
# camera uapi first (Forgejo #7 port list). Re-enable for the camera step.
# CONFIG_MSMB_CAMERA is not set

# Touchscreen: Goodix GT915L (from the 4.4 FIH kernel)
CONFIG_TOUCHSCREEN_GT9XX=y
CONFIG_TOUCHSCREEN_GT9XX_UPDATE=y
CONFIG_TOUCHSCREEN_GT9XX_TOOL=y

# FIH platform drivers (drivers/platform/fih from the 4.4 kernel): only what
# the ported drivers need so far; the rest is enabled as it gets ported.
CONFIG_FIH_INFO=y
CONFIG_FIH_TOUCH=y
# CONFIG_FIH_MFD is not set
# Modem NV RAM handoff in pil-msa (the FIH modem needs it)
CONFIG_FIH_NV=y
# CONFIG_FIH_APR is not set
# CONFIG_FIH_DDR is not set
# CONFIG_FIH_SENSOR is not set
# CONFIG_FIH_MFR is not set
CONFIG_FIH_LCM=y
# CONFIG_FIH_EMMC is not set
# CONFIG_FIH_FVER is not set
# CONFIG_FIH_USB is not set
# CONFIG_FIH_HWCONFIG is not set
# CONFIG_FIH_DEVICE_TREE_DEBUG is not set
# CONFIG_FIH_HALL_SENSOR is not set
CONFIG_PXLW_IRIS3=y
