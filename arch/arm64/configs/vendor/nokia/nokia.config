# Nokia (FIH/HMD) SDM630/636/660 devices on the 4.19 SDM660 kernel.
# Applied on top of vendor/sdm660-perf_defconfig; device fragments
# (vendor/nokia/<codename>.config) go last.

# A/B, recovery-as-boot (ABL passes skip_initramfs on normal boots)
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y

# Boot image: Image.gz with the device dtbs appended (no dtbo partition)
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES=""
CONFIG_IMG_GZ_DTB=y
CONFIG_BUILD_ARM64_APPENDED_KERNEL_IMAGE_NAME="Image.gz-dtb"

# ION: the stock Android 10 vendor blobs (libQSEEComAPI and with it the
# keymaster/gatekeeper HALs, the camera and display HALs) use the legacy
# ION ioctls. As in Sony's common.config.
CONFIG_ION_LEGACY=y

# Compiler
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set

# Filesystems
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"

# Pstore: ramoops is registered from the kernel cmdline (BoardConfig)
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Wi-Fi
CONFIG_QCA_CLD_WLAN=y
CONFIG_QCA_CLD_WLAN_PROFILE="default"
